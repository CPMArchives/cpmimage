+/* Check availability using the same RAW/skew addressing as readBlock. */
+int cpmImageBlockPresent(const struct cpmSuperBlock *d, int block)
+{
+  if (d->dev.imageLimit < 0) return 1;
+  int first=block*(d->blksiz/d->secLength)+bootOffset(d);
+  for (int n=0; n<d->blksiz/d->secLength; ++n)
+  {
+    int sector=first+n;
+    long long end=((long long)(sector/d->sectrk)*d->sectrk+
+      d->skewtab[sector%d->sectrk]+1)*d->secLength+d->offset;
+    if (end>d->dev.imageLimit) return 0;
+  }
+  return 1;
+}
