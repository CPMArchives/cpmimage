+static int cpmImageCheckDirectory(const struct cpmSuperBlock *d)
+{
+  unsigned char *seen=calloc((size_t)d->size,1);
+  if (!seen) { boo="Out of memory"; return -1; }
+  for (int i=0;i<d->maxdir;++i)
+  {
+    const struct PhysDirectoryEntry *entry=&d->dir[i];
+    unsigned char status=(unsigned char)entry->status;
+    if (status==0xe5 || ((d->type&CPMFS_CPM3_OTHER) && status>=16 && status<=32) ||
+        ((d->type&CPMFS_CPM3_DATES) && status==33)) continue;
+    if (status>(d->type&CPMFS_HI_USER ? 31 : 15) || (unsigned char)entry->blkcnt>128 ||
+        !ISFILECHAR(0,entry->name[0]&127))
+    {
+      boo="Invalid directory entry"; free(seen); return -1;
+    }
+    for (int j=0;j<16;++j)
+    {
+      int block=(unsigned char)entry->pointers[j];
+      if (d->size>256) block|=(unsigned char)entry->pointers[++j]<<8;
+      if (!block) continue;
+      if (block<d->dirblks || block>=d->size || seen[block])
+      {
+        boo="Invalid or duplicated file allocation"; free(seen); return -1;
+      }
+      seen[block]=1;
+      if (d->dev.imageLimit>=0)
+      {
+        int first=block*(d->blksiz/d->secLength)+bootOffset(d);
+        for (int n=0;n<d->blksiz/d->secLength;++n)
+        {
+          int sector=first+n;
+          long long end=((long long)(sector/d->sectrk)*d->sectrk+
+            d->skewtab[sector%d->sectrk]+1)*d->secLength+d->offset;
+          if (end>d->dev.imageLimit)
+          {
+            boo="Missing allocated sectors"; free(seen); return -1;
+          }
+        }
+      }
+    }
+  }
+  free(seen);
+  return 0;
+}
