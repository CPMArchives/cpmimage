+/* Scratch-only sequential inventory and payload export. The caller maps
+ * verified track/sector slots to RAW after this succeeds. */
+dsk_err_t cpmimage_tele_scan(DSK_DRIVER *s, FILE *out)
+{
+    DC_CHECK(s);
+    unsigned char seen_track[256][2] = {{0}};
+    unsigned char track[4], sector[8192];
+    unsigned long raw_size = 0;
+    if (self->tele_head.volume_seq || self->tele_head.sides < 1 ||
+        self->tele_head.sides > 2) return DSK_ERR_BADFMT;
+    if (fseek(self->tele_fp, self->tele_track_addr[0][0], SEEK_SET))
+        return DSK_ERR_SYSERR;
+    for (;;) {
+        if (tele_fread(self, track, 4)) return DSK_ERR_BADFMT;
+        unsigned count = track[0], cylinder = track[1], head = track[2] & 0x7f;
+        if (count == 255) return raw_size ? DSK_ERR_OK : DSK_ERR_BADFMT;
+        if ((unsigned char)teledisk_crc(track, 3) != track[3]) return DSK_ERR_DATAERR;
+        if (!count || head >= self->tele_head.sides || seen_track[cylinder][head]++)
+            return DSK_ERR_BADFMT;
+        unsigned char seen_id[256] = {0};
+        for (unsigned i = 0; i < count; ++i) {
+            dsk_err_t e = tele_readsechead(self);
+            if (e) return e;
+            unsigned id = self->tele_sechead.sector_id;
+            if (seen_id[id]++ || self->tele_sechead.cylinder_id != cylinder ||
+                self->tele_sechead.head_id != head) return DSK_ERR_BADFMT;
+            if (self->tele_sechead.syndrome & 0x30) return DSK_ERR_NODATA;
+            if (self->tele_sechead.syndrome & 0x46) return DSK_ERR_DATAERR;
+            long start = ftell(self->tele_fp);
+            if (start < 0) return DSK_ERR_SYSERR;
+            if (!self->tele_sechead.compressed_len) return DSK_ERR_BADFMT;
+            e = tele_readsec(self, sector);
+            if (e) return e;
+            if (ftell(self->tele_fp) - start != self->tele_sechead.compressed_len - 1)
+                return DSK_ERR_BADFMT;
+            unsigned size = self->tele_sechead.sector_len;
+            if ((unsigned char)teledisk_crc(sector, size) != self->tele_sechead.header_crc)
+                return DSK_ERR_DATAERR;
+            raw_size += size;
+            if (raw_size > 128UL * 1024 * 1024) return DSK_ERR_BADFMT;
+            unsigned char record[] = {cylinder, head, id, size & 255, size >> 8};
+            if (fwrite(record, 1, sizeof(record), out) != sizeof(record) ||
+                fwrite(sector, 1, size, out) != size) return DSK_ERR_SYSERR;
+        }
+    }
+}
