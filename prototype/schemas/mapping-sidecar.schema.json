{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CP/M Image physical mapping sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_order",
    "default"
  ],
  "properties": {
    "track_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "items": false
      }
    },
    "default": {
      "$ref": "#/$defs/trackDefaults"
    },
    "tracks": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])/[01](?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/trackFields"
      }
    }
  },
  "$defs": {
    "trackFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "size": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16384,
          "multipleOf": 128
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "trackDefaults": {
      "$ref": "#/$defs/trackFields",
      "required": [
        "mode",
        "size",
        "sectors"
      ]
    }
  }
}
